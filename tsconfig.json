{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@agenda-xpto/types": ["./packages/types/src/index.ts"],
      "@agenda-xpto/validations": ["./packages/validations/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
