{
  "name": "agenda-xpto",
  "private": true,
  "description": "Agenda XPTO monorepo",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed"
  },
  "lint-staged": {
    "apps/api/**/*.ts": "pnpm --filter api exec eslint --max-warnings=0 --no-warn-ignored --"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "turbo": "^2.5.4"
  }
}
