# Database (align user/password/db with docker-compose / POSTGRES_*)
DATABASE_URL=postgresql://agenda_xpto:agenda_xpto@127.0.0.1:5432/agenda_xpto

# Integration tests (same PostgreSQL instance, separate database — create manually; see apps/api/README.md)
DATABASE_URL_TEST=postgresql://agenda_xpto:agenda_xpto@127.0.0.1:5432/agenda_xpto_test

# Docker Compose — PostgreSQL 16
POSTGRES_USER=agenda_xpto
POSTGRES_PASSWORD=agenda_xpto
POSTGRES_DB=agenda_xpto

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth
AUTH_SECRET=change-me-in-development-use-at-least-32-characters
AUTH_URL=http://localhost:3001

# Email
RESEND_API_KEY=
# From address for Resend (verified domain in production)
RESEND_FROM=Agenda XPTO <onboarding@resend.dev>

# App
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
